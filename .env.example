# Mẫu cấu hình Firebase cho ứng dụng (bài 5 sẽ hướng dẫn điền).
#
# Cách dùng: sao chép file này thành ".env" rồi điền giá trị thật vào ".env".
# File ".env" đã nằm trong .gitignore: KHÔNG commit, KHÔNG dán vào chat với AI,
# KHÔNG gửi lên nhóm Zalo. File này (.env.example) chỉ chứa chỗ trống.
#
# Expo chỉ đưa vào ứng dụng các biến bắt đầu bằng EXPO_PUBLIC_.
# Sau khi sửa .env, hãy tắt rồi chạy lại "npx expo start".

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Chỉ cần nếu bài 5 dùng Realtime Database:
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
